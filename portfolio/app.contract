// Ben Meyer's portfolio: one screen of sections in a centred reading column.
// The content lives in app.ts; this file is the view. The one colour written is the
// accent, in app.tamber; surfaces and text are roles, so dark mode is the platform's.

routes nav
  home "/"

shape Profile
  name: string
  title: string
  intro: string
  bio: string
  location: string
  education: string
  honors: string

shape Job
  id: string
  company: string
  role: string
  dates: string
  place: string
  url: string
  points: string[]
  tags: string[]

shape Project
  id: string
  name: string
  dates: string
  summary: string
  tags: string[]
  url: string

shape SkillGroup
  id: string
  label: string
  items: string

shape Link
  id: string
  label: string
  detail: string
  url: string

style sectionTitle
  font="-exact-title2"
  font-weight=700
  -exact-fit="shrink"

style card
  background-color="-exact-secondary-background"
  border-radius=14
  padding=20
  gap=10

style tagText
  font="-exact-footnote"
  color="-exact-secondary-label"

component Portfolio
  resource profile = profile() as shape Profile
  resource experience = experience() as shape Job[]
  resource projects = projects() as shape Project[]
  resource skills = skills() as shape SkillGroup[]
  resource links = links() as shape Link[]

  action follow(url: string)
    nav = go(nav, url)

  view
    main testId="root" navigationKey=`${top(nav).id}` navigate=follow width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="content" position="absolute" inset=0 display="flex" flex-direction="column"
            scroll id="content" flex=1 min-height=0 testId="page"
              column gap=56 padding="56px 24px 72px" max-width="46rem" margin-left="auto" margin-right="auto"

                // Hero: the focal point is the name, in large type.
                column gap=12 testId="hero"
                  text profile.title color="accent.text" font="-exact-subheadline" font-weight=600 testId="hero-title"
                  text profile.name role="heading" aria-level=1 font-size="2.5rem" font-weight=700 line-height=1.2 -exact-fit="shrink" testId="hero-name"
                  text profile.intro font="-exact-title3" color="-exact-secondary-label" testId="hero-intro"
                  text profile.bio line-height=1.5 testId="hero-bio"
                  row flex-wrap="wrap" gap=16 padding-top=4
                    for l in links key=l.id
                      link href=l.url color="accent.text" testId=`hero-link-${l.id}`
                        text l.label

                // Experience
                column id="experience" gap=16 testId="experience"
                  text "Experience" role="heading" aria-level=2 class=sectionTitle testId="experience-heading"
                  for j in experience key=j.id
                    column class=card testId=`job-${j.id}`
                      row flex-wrap="wrap" column-gap=12 row-gap=2 align-items="baseline"
                        text j.role font="-exact-headline" flex="1 1 14rem" testId=`job-${j.id}-role`
                        text j.dates class=tagText testId=`job-${j.id}-dates`
                      link href=j.url color="accent.text" testId=`job-${j.id}-link`
                        text `${j.company} · ${j.place}` testId=`job-${j.id}-company`
                      column gap=6 padding-top=4
                        for p in j.points key=p
                          row gap=10 align-items="flex-start"
                            text "–" color="accent.text"
                            text p flex=1 min-width=0 line-height=1.45 overflow-wrap="break-word"
                      text j.tags.join(" · ") class=tagText

                // Projects
                column id="projects" gap=16 testId="projects"
                  text "Projects" role="heading" aria-level=2 class=sectionTitle testId="projects-heading"
                  row flex-wrap="wrap" gap=16 align-items="stretch"
                    for p in projects key=p.id
                      column class=card flex="1 1 18rem" min-width=0 testId=`project-${p.id}`
                        text p.name font="-exact-headline" testId=`project-${p.id}-name`
                        if p.dates != ""
                          text p.dates class=tagText
                        text p.summary line-height=1.45 flex=1 overflow-wrap="break-word"
                        text p.tags.join(" · ") class=tagText
                        link href=p.url color="accent.text" testId=`project-${p.id}-link`
                          text "View on GitHub"

                // Skills
                column id="skills" gap=16 testId="skills"
                  text "Skills" role="heading" aria-level=2 class=sectionTitle testId="skills-heading"
                  dl class=card margin=0
                    for s in skills key=s.id
                      column gap=2 padding-bottom=8
                        dt font="-exact-subheadline" font-weight=600 color="accent.text" testId=`skill-${s.id}-label`
                          text s.label
                        dd margin=0 line-height=1.45 testId=`skill-${s.id}`
                          text s.items
                  column class=card testId="education"
                    text profile.education font="-exact-headline" testId="education-degree"
                    text profile.honors class=tagText

                // Contact
                column id="contact" gap=16 testId="contact"
                  text "Get in touch" role="heading" aria-level=2 class=sectionTitle testId="contact-heading"
                  text "Always happy to talk engineering, AI tooling, or a good movie recommendation." color="-exact-secondary-label"
                  column class=card gap=14
                    for l in links key=l.id
                      row flex-wrap="wrap" column-gap=12 row-gap=2 align-items="baseline"
                        text l.label font="-exact-subheadline" font-weight=600 min-width="6rem"
                        link href=l.url color="accent.text" testId=`contact-${l.id}`
                          text l.detail testId=`contact-${l.id}-text`
                  text `© 2026 ${profile.name}` class=tagText text-align="center" testId="footer"
