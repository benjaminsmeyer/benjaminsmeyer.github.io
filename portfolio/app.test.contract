// The portfolio's contract: every section renders real content from app.ts (never a
// placeholder), and every link is present and points where it should.

test "the hero shows the name, title and intro"
  clock data
  expect tree has "hero"
  expect text "hero-name" == "Benjamin Meyer"
  expect text "hero-title" == "Software Engineer at Microsoft"
  expect text "hero-intro" == "Full-stack engineer building agentic AI products people use every day."
  expect state profile.location == "Redmond, WA"
  expect tree has "hero-bio"
  expect tree missing "greeting"
  expect tree has "hero-link-email"
  expect tree has "hero-link-linkedin"
  expect tree has "hero-link-github"
  expect tree has "hero-link-website"

test "experience lists every role from the résumé, newest first"
  clock data
  expect text "experience-heading" == "Experience"
  expect text "job-microsoft-swe-role" == "Software Engineer"
  expect text "job-microsoft-swe-company" == "Microsoft · Redmond, WA"
  expect text "job-microsoft-swe-dates" == "Jul 2026 – Now"
  expect text "job-microsoft-intern-role" == "Software Engineer Intern"
  expect text "job-microsoft-intern-dates" == "May – Aug 2025"
  expect text "job-nara-logics-role" == "Software Engineer Co-op"
  expect text "job-nara-logics-company" == "Nara Logics · Boston, MA"
  expect text "job-harbourvest-role" == "Security Engineer Co-op"
  expect text "job-harbourvest-company" == "HarbourVest Partners · Boston, MA"
  expect state experience.0 .points.0 == "Shipped a full-stack agentic AI feature to production in under six weeks, owning the TypeScript UX, C# APIs, LLM orchestration and prompts."
  expect state experience.3 .points.0 == "Automated incident triage across Splunk and CrowdStrike in Python, taking response time from 4 hours to 15 minutes and saving 300+ hours a year."
  expect tree has "job-microsoft-swe-link"
  expect tree has "job-harbourvest-link"
  expect state experience.0 .url == "https://www.microsoft.com"
  expect state experience.2 .url == "https://naralogics.com"
  expect state experience.3 .url == "https://www.harbourvest.com"

test "projects show the résumé's work, each with a GitHub link"
  clock data
  expect text "projects-heading" == "Projects"
  expect text "project-nlp-emotion-name" == "NLP Emotion Analysis"
  expect text "project-pips-solver-name" == "NYTimes Pips AI Solver"
  expect text "project-kambaz-name" == "Kambaz"
  expect text "project-visualag-name" == "visuaLAG"
  expect tree has "project-nlp-emotion-link"
  expect tree has "project-pips-solver-link"
  expect tree has "project-kambaz-link"
  expect tree has "project-visualag-link"
  expect state projects.0 .url == "https://github.com/benjaminsmeyer/nlp-emotion-analysis"
  expect state projects.1 .url == "https://github.com/benjaminsmeyer/nytimes-pips-ai"

test "skills and education come from the résumé"
  clock data
  expect text "skills-heading" == "Skills"
  expect text "skill-languages-label" == "Languages"
  expect tree has "skill-languages"
  expect state skills.0 .items.0 == "TypeScript"
  expect state skills.0 .items.6 == "SQL"
  expect text "skill-technologies-label" == "Frameworks & AI"
  expect state skills.1 .items.9 == "MCP"
  expect text "skill-ai-tools-label" == "AI Dev Tools"
  expect state skills.2 .items.0 == "Claude Code"
  expect state skills.2 .items.1 == "Codex"
  expect state skills.2 .items.2 == "GitHub Copilot"
  expect text "skill-databases-label" == "Data"
  expect state skills.3 .items.0 == "PostgreSQL"
  expect text "skill-infrastructure-label" == "Cloud & DevOps"
  expect state skills.4 .items.3 == "Kubernetes"
  expect text "education-degree" == "Northeastern University"
  expect state profile.honors == "B.S. Computer Science, Minor in Business Administration · 2026 · 3.92 GPA, Summa Cum Laude · TA for Fundamentals of CS I and II"

test "contact links are present and point at the real profiles"
  clock data
  expect text "contact-heading" == "Contact"
  expect text "contact-email-text" == "bmeyerswe@gmail.com"
  expect text "contact-linkedin-text" == "linkedin.com/in/benjaminsmeyer"
  expect text "contact-github-text" == "github.com/benjaminsmeyer"
  expect text "contact-website-text" == "bensmeyer.com"
  expect state links.0 .url == "mailto:bmeyerswe@gmail.com"
  expect state links.1 .url == "https://linkedin.com/in/benjaminsmeyer"
  expect state links.2 .url == "https://github.com/benjaminsmeyer"
  expect state links.3 .url == "https://bensmeyer.com"
  expect text "contact-cta" == "Let's build something."
  expect text "footer" == "© 2026 Benjamin Meyer · Built with Exact"

test "a phone shows every section in one column"
  size 390x844
  clock data
  expect tree has "hero"
  expect tree has "experience"
  expect tree has "projects"
  expect tree has "skills"
  expect tree has "contact"

test "a wide window shows every section in its reading column"
  size 1280x800
  clock data
  expect tree has "hero"
  expect tree has "projects"
  expect tree has "contact"
